{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hero Craft",
  "version": "0.3.0",
  "identifier": "com.herocraft.dev",
  "mainBinaryName": "Hero Craft",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hero Craft",
        "width": 1400,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMTAyM0Q1OTMwRUNGNDMKUldSRHp3NlQxU01RcWxkbnJPVE9zU3hHU2pGeTRjcHdZOVNHbTVPM3VuYTNjK3Njb2pjQXJTZE8K",
      "endpoints": [
        "https://github.com/LeSsasA27/hero-craft/releases/latest/download/latest.json"
      ]
    }
  }
}
